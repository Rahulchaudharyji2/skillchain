# Database connection (PostgreSQL in production, SQLite or Postgres in dev)
DATABASE_URL="file:./dev.db"

# Authentication (Clerk in production, Demo Switcher enabled by default)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_SECRET_KEY="sk_test_placeholder_key"
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS="true"

# Blockchain Configuration (Polygon Amoy testnet)
NEXT_PUBLIC_POLYGON_AMOY_CHAIN_ID="80002"
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
NEXT_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
POLYGON_ISSUER_PRIVATE_KEY=""
POLYGON_SCAN_API_KEY=""

# AI Provider Configuration (Provider-independent layer: mock / openai / anthropic / gemini / groq)
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Sandboxed Code Execution (Judge0 or isolated runner)
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
USE_LOCAL_EXECUTION_RUNNER="true"

# App & Verification URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
